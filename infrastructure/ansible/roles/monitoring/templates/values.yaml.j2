# Values для kube-prometheus-stack. Ресурсы подобраны консервативно под
# одну небольшую ноду; при росте кластера/диска увеличивайте.

grafana:
  # Свой пароль вместо общеизвестного дефолта чарта (prom-operator).
  adminPassword: "{{ grafana_admin_password }}"
  # NodePort — единый способ доступа к UI, пока Ingress отключён.
  service:
    type: NodePort
    nodePort: {{ grafana_nodeport }}
  persistence:
    enabled: true
    storageClassName: {{ prometheus_storage_class }}
    size: {{ grafana_storage_size }}
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 200m
      memory: 256Mi

prometheus:
  prometheusSpec:
    retention: {{ prometheus_retention }}
    retentionSize: {{ prometheus_retention_size }}
    resources:
      requests:
        cpu: 100m
        memory: 512Mi
      limits:
        cpu: 500m
        memory: 1Gi
    # Метрики переживают перезапуск пода — том на Longhorn.
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ prometheus_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: {{ prometheus_storage_size }}
    # Подхватывать ServiceMonitor/PodMonitor/PrometheusRule из ВСЕХ неймспейсов,
    # а не только помеченные лейблами этого релиза. Так ваши приложения смогут
    # отдавать метрики Prometheus, просто добавив свой ServiceMonitor.
    serviceMonitorSelectorNilUsesHelmValues: false
    podMonitorSelectorNilUsesHelmValues: false
    ruleSelectorNilUsesHelmValues: false

alertmanager:
{% if alertmanager_webhook_url %}
  # Маршрутизация алертов на вебхук. Критичные шлём отдельной группой и
  # повторяем чаще — чтобы их не потерять среди предупреждений.
  config:
    route:
      receiver: default-webhook
      group_by: ['alertname', 'namespace']
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h
      routes:
        - receiver: default-webhook
          matchers:
            - severity = "critical"
          repeat_interval: 1h
    receivers:
      - name: default-webhook
        webhook_configs:
          - url: "{{ alertmanager_webhook_url }}"
            send_resolved: true
{% endif %}
  alertmanagerSpec:
    resources:
      requests:
        cpu: 25m
        memory: 64Mi
      limits:
        cpu: 100m
        memory: 128Mi

prometheus-node-exporter:
  resources:
    requests:
      cpu: 25m
      memory: 32Mi
    limits:
      cpu: 100m
      memory: 64Mi

kube-state-metrics:
  resources:
    requests:
      cpu: 25m
      memory: 64Mi
    limits:
      cpu: 100m
      memory: 128Mi
